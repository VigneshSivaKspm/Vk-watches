# VK TIME - API server settings
# Copy this file to apps/api/.env and fill in the blank values.

# ---- Server --------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---- Database ------------------------------------------------------------
# SQLite file path, relative to apps/api/prisma
DATABASE_URL="file:./dev.db"

# ---- Login security ------------------------------------------------------
# Long random text that signs login tokens. Changing it signs everyone out.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- AI chatbot (Groq) ---------------------------------------------------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: model to try first (blank = openai/gpt-oss-120b)
GROQ_MODEL=

# ---- Not used by the code yet --------------------------------------------
# Reserved for a real Razorpay integration and a restricted storefront URL.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CLIENT_URL=http://localhost:5173
