datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  phone        String?
  role         String         @default("CUSTOMER")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlists    WishlistItem[]
  cart         Cart?
  auditLogs    AuditLog[]
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  email        String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String   @default("India")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Collection {
  id            String    @id @default(uuid())
  slug          String    @unique
  name          String
  tagline       String
  description   String
  heroImage     String
  thumbnailImage String
  accentQuote   String?
  aestheticTone String    @default("Refined Minimalist")
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id               String               @id @default(uuid())
  slug             String               @unique
  title            String
  subtitle         String
  description      String
  shortDescription String
  categoryId       String?
  category         Category?            @relation(fields: [categoryId], references: [id])
  collectionId     String?
  collection       Collection?          @relation(fields: [collectionId], references: [id])
  gender           String               @default("Unisex")
  movementType     String               @default("Automatic")
  caseDiameterMm   Float                @default(40.0)
  price            Float
  compareAtPrice   Float?
  currency         String               @default("INR")
  isFeatured       Boolean              @default(false)
  isNewArrival     Boolean              @default(false)
  isBestseller     Boolean              @default(false)
  isLimitedEdition Boolean              @default(false)
  editionLimit     Int?
  stock            Int                  @default(10)
  primaryImage     String
  secondaryImage   String
  galleryImages    String               // JSON string array
  specifications   ProductSpecification?
  variants         ProductVariant[]
  reviews          Review[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model ProductSpecification {
  id                    String   @id @default(uuid())
  productId             String   @unique
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand                 String   @default("VK TIME")
  modelName             String
  modelNumber           String
  sku                   String   @unique
  countryOfOrigin       String   @default("Switzerland / Assembly India")
  movementType          String
  movementManufacturer  String
  calibre               String
  powerSource           String
  powerReserve          String
  accuracy              String
  frequency             String
  jewelCount            Int
  caseMaterial          String
  caseDiameterMm        Float
  caseThicknessMm       Float
  caseShape             String   @default("Round")
  caseColour            String
  caseFinish            String
  bezelMaterial         String
  caseBackType          String
  crownType             String
  lugToLugMm            Float
  dialColour            String
  dialFinish            String
  displayType           String
  hourMarkers           String
  handMaterial          String
  luminousIndicators    String
  dateDisplay           Boolean  @default(true)
  dayDisplay            Boolean  @default(false)
  subDials              Int      @default(0)
  crystalMaterial       String
  antiReflectiveCoating Boolean  @default(true)
  strapMaterial         String
  strapColour           String
  strapWidthMm          Float
  lugWidthMm            Float
  braceletConstruction  String
  claspType             String
  interchangeableStrap  Boolean  @default(true)
  waterResistanceAtm    Int      @default(5)
  waterResistanceMeters Int      @default(50)
  shockResistance       Boolean  @default(true)
  magneticResistance    String   @default("4,800 A/m")
  productWeightGrams    Float
  wristSizeMinMm        Float    @default(150)
  wristSizeMaxMm        Float    @default(210)
  warrantyYears         Int      @default(3)
  packageContents       String   // JSON string array
  careInstructions      String
}

model ProductVariant {
  id             String      @id @default(uuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String      @unique
  dialColour     String
  strapColour    String
  strapMaterial  String
  price          Float
  compareAtPrice Float?
  stock          Int         @default(5)
  imageUrls      String      // JSON string array
  orderItems     OrderItem[]
  cartItems      CartItem[]
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id            String          @id @default(uuid())
  cartId        String
  cart          Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  quantity      Int             @default(1)
  selectedDial  String?
  selectedStrap String?
  price         Float
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Order {
  id             String        @id @default(uuid())
  orderNumber    String        @unique
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  isGuest        Boolean       @default(false)
  customerName   String
  customerEmail  String
  customerPhone  String
  shippingAddress String       // JSON string of address
  subtotal       Float
  shippingFee    Float         @default(0)
  taxAmount      Float         @default(0)
  discountAmount Float         @default(0)
  couponCode     String?
  totalAmount    Float
  currency       String        @default("INR")
  paymentMethod  String        @default("UPI")
  paymentStatus  String        @default("PENDING")
  orderStatus    String        @default("ORDER_PLACED")
  trackingNumber String?
  courierName    String?
  notes          String?
  items          OrderItem[]
  timeline       OrderTimeline[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model OrderItem {
  id            String          @id @default(uuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  productTitle  String
  sku           String
  image         String
  price         Float
  quantity      Int
  selectedDial  String?
  selectedStrap String?
  subtotal      Float
}

model OrderTimeline {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String
  timestamp   DateTime    @default(now())
  description String
}

model Review {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  authorName       String
  rating           Int
  title            String
  comment          String
  verifiedPurchase Boolean  @default(true)
  isApproved       Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String
  discountPercent Float?
  discountAmount  Float?
  minOrderValue   Float?
  validUntil     DateTime
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

model Banner {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?
  linkUrl     String?
  imageUrl    String
  position    String   @default("HERO")
  isActive    Boolean  @default(true)
  displayOrder Int     @default(0)
}

model JournalArticle {
  id                 String   @id @default(uuid())
  slug               String   @unique
  title              String
  excerpt            String
  content            String
  author             String
  readingTimeMinutes Int      @default(5)
  category           String
  coverImage         String
  tags               String   // JSON string array
  publishedAt        DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}
