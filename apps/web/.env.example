# VK TIME - Storefront settings
# Everything starting with VITE_ is visible to website visitors.
# Never put passwords or API keys in this file.

# Where the website finds the API.
# Development: /api (forwarded to http://localhost:4000 by vite.config.ts)
# Production:  the full address, e.g. https://api.your-domain.com/api
VITE_API_BASE_URL=/api
